---
title: "Svelte UPI QR Code Generator"
description: "Svelte component that generates UPI QR codes using upiqrcode from CDN"
---

<div id="svelte-upi-qr" style="padding: 1rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; background-color: #f9fafb; max-width: 600px; margin: 2rem auto;">
    <h3 style="margin-top: 0; color: #1f2937;">Svelte UPI QR Generator</h3>
    
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <label for="svelte-upi-vpa" style="font-weight: 500; color: #374151;">UPI VPA:</label>
        <input type="text" id="svelte-upi-vpa" placeholder="Enter UPI VPA (e.g., example@paytm)" 
               style="padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.25rem; font-size: 1rem;">
        
        <label for="svelte-upi-amount" style="font-weight: 500; color: #374151;">Amount (₹):</label>
        <input type="number" id="svelte-upi-amount" placeholder="Enter amount" min="1"
               style="padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.25rem; font-size: 1rem;">
        
        <label for="svelte-upi-note" style="font-weight: 500; color: #374151;">Note (optional):</label>
        <input type="text" id="svelte-upi-note" placeholder="Enter note (optional)"
               style="padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.25rem; font-size: 1rem;">
        
        <button id="svelte-upi-generate" style="background-color: #3b82f6; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.375rem; font-weight: 500; cursor: pointer; margin-top: 1rem;">
            Generate QR Code
        </button>
        
        <div id="svelte-upi-result" style="margin-top: 1.5rem; text-align: center; min-height: 200px;">
            <div id="svelte-upi-loading" style="display: none; margin: 1rem auto; width: 40px; height: 40px; border: 4px solid #f3f4f6; border-top: 4px solid #3b82f6; border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <img id="svelte-upi-image" src="" alt="QR Code" style="max-width: 200px; margin: 0 auto; display: none;" />
            <div id="svelte-upi-error" style="color: #dc2626; margin-top: 1rem; min-height: 1.5rem;"></div>
        </div>
    </div>
</div>

<style>
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

<script is:inline>
    // Load upiqrcode from CDN when component mounts
    let upiqrcodeLoaded = false;

    function loadUpiqrcode() {
        return new Promise((resolve, reject) => {
            if (window.upiqrcode) {
                resolve(window.upiqrcode);
                return;
            }
            
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/upiqrcode@1.5.5/upiqrcode.js';
            script.onload = () => {
                setTimeout(() => {
                    if (window.upiqrcode) {
                        resolve(window.upiqrcode);
                    } else {
                        reject(new Error('Failed to load upiqrcode'));
                    }
                }, 100);
            };
            script.onerror = () => reject(new Error('Failed to load upiqrcode script'));
            document.head.appendChild(script);
        });
    }

    document.addEventListener('DOMContentLoaded', async () => {
        const vpaInput = document.getElementById('svelte-upi-vpa');
        const amountInput = document.getElementById('svelte-upi-amount');
        const noteInput = document.getElementById('svelte-upi-note');
        const generateBtn = document.getElementById('svelte-upi-generate');
        const resultDiv = document.getElementById('svelte-upi-result');
        const loadingDiv = document.getElementById('svelte-upi-loading');
        const imageElement = document.getElementById('svelte-upi-image');
        const errorDiv = document.getElementById('svelte-upi-error');
        
        generateBtn.addEventListener('click', async () => {
            const vpa = vpaInput.value.trim();
            const amount = amountInput.value.trim();
            const note = noteInput.value.trim() || 'UPI Payment';
            
            // Clear previous results
            errorDiv.textContent = '';
            imageElement.style.display = 'none';
            
            // Basic validation
            if (!vpa) {
                errorDiv.textContent = 'Please enter UPI VPA';
                return;
            }
            
            if (!amount || parseFloat(amount) <= 0) {
                errorDiv.textContent = 'Please enter a valid amount';
                return;
            }
            
            try {
                // Show loading
                loadingDiv.style.display = 'block';
                generateBtn.disabled = true;
                generateBtn.textContent = 'Generating...';
                
                // Load upiqrcode if not already loaded
                if (!upiqrcodeLoaded) {
                    await loadUpiqrcode();
                    upiqrcodeLoaded = true;
                }
                
                // Generate QR code
                const result = await window.upiqrcode({
                    payeeVPA: vpa,
                    amount: amount,
                    currency: 'INR',
                    transactionNote: note
                });
                
                if (result && result.qr) {
                    // Display QR code
                    imageElement.src = `data:image/png;base64,${result.qr}`;
                    imageElement.style.display = 'block';
                    imageElement.alt = 'UPI QR Code';
                } else {
                    errorDiv.textContent = 'Failed to generate QR code';
                }
            } catch (err) {
                console.error('Error generating QR code:', err);
                errorDiv.textContent = 'Error generating QR code. Please try again.';
            } finally {
                // Hide loading
                loadingDiv.style.display = 'none';
                generateBtn.disabled = false;
                generateBtn.textContent = 'Generate QR Code';
            }
        });
        
        // Allow Enter key to trigger generation
        [vpaInput, amountInput, noteInput].forEach(input => {
            input.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    generateBtn.click();
                }
            });
        });
    });
</script>