---
title: "Vue UPI QR Code Generator"
description: "Vue component that generates UPI QR codes using upiqrcode from CDN"
---

<div id="vue-upi-qr" style="padding: 1rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; background-color: #f9fafb; max-width: 600px; margin: 2rem auto;">
    <h3 style="margin-top: 0; color: #1f2937;">Vue UPI QR Generator</h3>
    
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <label for="vue-upi-vpa" style="font-weight: 500; color: #374151;">UPI VPA:</label>
        <input type="text" id="vue-upi-vpa" placeholder="Enter UPI VPA (e.g., example@paytm)" 
               style="padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.25rem; font-size: 1rem;">
        
        <label for="vue-upi-amount" style="font-weight: 500; color: #374151;">Amount (₹):</label>
        <input type="number" id="vue-upi-amount" placeholder="Enter amount" min="1"
               style="padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.25rem; font-size: 1rem;">
        
        <label for="vue-upi-note" style="font-weight: 500; color: #374151;">Note (optional):</label>
        <input type="text" id="vue-upi-note" placeholder="Enter note (optional)"
               style="padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 0.25rem; font-size: 1rem;">
        
        <button id="vue-upi-generate" style="background-color: #3b82f6; color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 0.375rem; font-weight: 500; cursor: pointer; margin-top: 1rem;">
            Generate QR Code
        </button>
        
        <div id="vue-upi-result" style="margin-top: 1.5rem; text-align: center; min-height: 200px;">
            <div id="vue-upi-loading" style="display: none; margin: 1rem auto; width: 40px; height: 40px; border: 4px solid #f3f4f6; border-top: 4px solid #3b82f6; border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <img id="vue-upi-image" src="" alt="QR Code" style="max-width: 200px; margin: 0 auto; display: none;" />
            <div id="vue-upi-error" style="color: #dc2626; margin-top: 1rem; min-height: 1.5rem;"></div>
        </div>
    </div>
</div>

<style>
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

<script is:inline>
    // Load upiqrcode from CDN when component mounts
    let upiqrcodeLoaded = false;

    function loadUpiqrcode() {
        return new Promise((resolve, reject) => {
            if (window.upiqrcode) {
                resolve(window.upiqrcode);
                return;
            }
            
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/upiqrcode@1.5.5/upiqrcode.js';
            script.onload = () => {
                setTimeout(() => {
                    if (window.upiqrcode) {
                        resolve(window.upiqrcode);
                    } else {
                        reject(new Error('Failed to load upiqrcode'));
                    }
                }, 100);
            };
            script.onerror = () => reject(new Error('Failed to load upiqrcode script'));
            document.head.appendChild(script);
        });
    }

    document.addEventListener('DOMContentLoaded', async () => {
        const vpaInput = document.getElementById('vue-upi-vpa');