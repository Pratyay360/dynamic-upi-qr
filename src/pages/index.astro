---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ReactUPIQRCode from '../components/ReactUPIQRCode';
---

<Layout
  title="Dynamic UPI QR Code Generator - Showcase & Demos"
  description="Generate instant UPI payment QR codes using the Rust-powered WebAssembly library upiqrcode. Demonstrates Astro's  Architecture across React, Vue, Svelte, and plain HTML."
>
  <div class="min-h-screen bg-white dark:bg-stone-950 text-stone-800 dark:text-stone-200 flex flex-col selection:bg-stone-200 dark:selection:bg-stone-800">
    <Navigation />

    <main class="flex-grow">
      <!-- Hero Section -->
      <section class="relative py-20 px-6 sm:px-8 border-b border-stone-200 dark:border-stone-900 bg-stone-50/50 dark:bg-stone-900/10">
        <div class="mx-auto max-w-4xl text-center relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-xs font-semibold text-stone-600 dark:text-stone-400 mb-6">
            <span>🦀</span> Rust to WebAssembly
          </div>

          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-stone-900 dark:text-stone-50 mb-6 leading-tight">
            Universal UPI QR Code Generator
          </h1>

          <p class="text-md sm:text-lg text-stone-600 dark:text-stone-400 max-w-2xl mx-auto mb-10 leading-relaxed font-sans">
            A high-performance WebAssembly library that compiles secure, compliant UPI payment intent links into vector SVGs directly in the browser. Fully local, client-side, and privacy-first.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="#interactive-demo"
              class="w-full sm:w-auto px-6 py-3 rounded-lg bg-stone-900 hover:bg-stone-800 dark:bg-stone-100 dark:hover:bg-stone-200 text-white dark:text-stone-950 font-bold text-sm tracking-wide transition-all text-center"
            >
              Try Generator
            </a>
            <a
              href="https://github.com/Pratyay360/upiqrcode"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-6 py-3 rounded-lg bg-white hover:bg-stone-50 dark:bg-stone-900 dark:hover:bg-stone-800/80 border border-stone-300 dark:border-stone-800 text-stone-700 dark:text-stone-300 font-bold text-sm tracking-wide transition-all text-center"
            >
              View Repository
            </a>
          </div>
        </div>
      </section>

      <!--  Architecture Showcase -->
      <section class="py-16 px-6 sm:px-8 max-w-7xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">

          <a href="/react" class="group block p-6 rounded-xl border border-stone-200 dark:border-stone-800/80 bg-stone-50/30 dark:bg-stone-900/20 hover:bg-stone-50 dark:hover:bg-stone-900/40 hover:border-stone-300 dark:hover:border-stone-700 transition-all duration-200">
            <div class="flex items-center gap-3 mb-4">
              <div class="h-8 w-8 flex items-center justify-center rounded bg-stone-100 dark:bg-stone-800 text-stone-800 dark:text-stone-200 text-sm font-bold">
                RE
              </div>
              <h3 class="text-md font-bold text-stone-900 dark:text-stone-100">React Island</h3>
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 leading-relaxed mb-4">
              Explore the React integration. Built with native React hooks managing dynamic CDN load and WASM logic.
            </p>
            <span class="text-xs font-bold text-stone-700 dark:text-stone-300 group-hover:underline">View Page &rarr;</span>
          </a>

          <!-- Vue Island Card -->
          <a href="/vue" class="group block p-6 rounded-xl border border-stone-200 dark:border-stone-800/80 bg-stone-50/30 dark:bg-stone-900/20 hover:bg-stone-50 dark:hover:bg-stone-900/40 hover:border-stone-300 dark:hover:border-stone-700 transition-all duration-200">
            <div class="flex items-center gap-3 mb-4">
              <div class="h-8 w-8 flex items-center justify-center rounded bg-stone-100 dark:bg-stone-800 text-stone-800 dark:text-stone-200 text-sm font-bold">
                VU
              </div>
              <h3 class="text-md font-bold text-stone-900 dark:text-stone-100">Vue Island</h3>
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 leading-relaxed mb-4">
              Explore the Vue 3 integration. Uses Composition API to mount and render the compiler on the client.
            </p>
            <span class="text-xs font-bold text-stone-700 dark:text-stone-300 group-hover:underline">View Page &rarr;</span>
          </a>

          <!-- Svelte Island Card -->
          <a href="/svelte" class="group block p-6 rounded-xl border border-stone-200 dark:border-stone-800/80 bg-stone-50/30 dark:bg-stone-900/20 hover:bg-stone-50 dark:hover:bg-stone-900/40 hover:border-stone-300 dark:hover:border-stone-700 transition-all duration-200">
            <div class="flex items-center gap-3 mb-4">
              <div class="h-8 w-8 flex items-center justify-center rounded bg-stone-100 dark:bg-stone-800 text-stone-800 dark:text-stone-200 text-sm font-bold">
                SV
              </div>
              <h3 class="text-md font-bold text-stone-900 dark:text-stone-100">Svelte Island</h3>
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 leading-relaxed mb-4">
              Explore the Svelte integration. Leveraging reactive variables and lightweight template structures.
            </p>
            <span class="text-xs font-bold text-stone-700 dark:text-stone-300 group-hover:underline">View Page &rarr;</span>
          </a>
        </div>

        <!-- Interactive Demo Container -->
        <div id="interactive-demo" class="scroll-mt-20 pt-8">
          <div class="text-center mb-8">
            <h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50">
              Interactive Generator
            </h2>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-2">
              Generate a UPI QR code below. Processing is done completely inside your browser.
            </p>
          </div>

          <ReactUPIQRCode client:load />
        </div>
      </section>

      <!-- Package Documentation -->
      <section class="py-16 border-t border-stone-200 dark:border-stone-900 bg-stone-50/30 dark:bg-stone-900/10 px-6 sm:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50 mb-6 text-center">
            Getting Started
          </h2>

          <div class="bg-white dark:bg-stone-950 border border-stone-200 dark:border-stone-800 rounded-xl p-6 mb-8">
            <h3 class="text-xs font-bold uppercase tracking-wider text-stone-400 mb-3">Install npm package</h3>
            <div class="flex items-center justify-between p-3.5 rounded-lg bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800">
              <code class="text-xs font-mono text-stone-700 dark:text-stone-300 select-all block">npm install upiqrcode</code>
              <span class="text-[10px] uppercase font-bold text-stone-400 dark:text-stone-600">Bash</span>
            </div>
          </div>

          <div class="space-y-6">
            <h3 class="text-lg font-bold text-stone-900 dark:text-stone-200">How it works</h3>
            <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
              India's UPI ecosystem runs on intent URLs mapped to QR codes. The `upiqrcode` library uses the Rust `qrcode` compiler internally to compile vector SVGs. It performs validation on required fields (VPA & payee name) to ensure compliance.
            </p>
            <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
              By loading this package as a client side module, you bypass any server processing. All generation occurs in the memory sandbox of the user's browser, providing a zero-tracking, private workflow.
            </p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 dark:border-stone-900 py-10 px-6 sm:px-8 bg-white dark:bg-stone-950 text-center text-xs text-stone-500 dark:text-stone-600">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>&copy; 2026 Dynamic UPI. All rights reserved.</p>
        <p>Demonstrating browser WebAssembly UPI QR generation inside the Astro framework.</p>
      </div>
    </footer>
  </div>
</Layout>
