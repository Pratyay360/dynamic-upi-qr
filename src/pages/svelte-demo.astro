<script>
  import { onMount } from 'svelte';
  import { toast } from 'svelte-toaster';

  let loading = false;
  let qrCode = '';
  let payeeVPA = '';
  let amount = '';
  let note = 'Test transaction';
  let error = '';

  async function generateQR() {
    if (!payeeVPA || !amount) {
      error = 'Please fill all required fields';
      return;
    }

    loading = true;
    error = '';

    try {
      const result = await upiqrcode({
        payeeVPA,
        amount,
        currency: 'INR',
        transactionNote: note
      });

      if (result.qr) {
        qrCode = result.qr;
        toast.success('QR Code generated successfully!', {
          position: 'bottom-right',
          duration: 3000
        });
      }
    } catch (err) {
      error = 'Failed to generate QR Code';
      toast.error('Failed to generate QR Code', {
        position: 'bottom-right',
        duration: 3000
      });
    } finally {
      loading = false;
    }
  }

  async function downloadQR() {
    if (!qrCode) return;

    const link = document.createElement('a');
    link.href = `data:image/png;base64,${qrCode}`;
    link.download = 'upi-qr-code.png';
    link.click();
  }

  onMount(async () => {
    // Load upiqrcode from CDN
    if (typeof window !== 'undefined') {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/upiqrcode@1.5.5/upiqrcode.js';
      script.onload = () => {
        window.upiqrcode = window.upiqrcode;
      };
      document.head.appendChild(script);
    }
  });
</script>

